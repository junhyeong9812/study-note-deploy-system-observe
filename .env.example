# 관측 서버 설정 — 서버의 .env 에 복사해 값을 채운다. 이 파일에는 실제 값을 적지 않는다.

BIND_ADDR=                      # 이 서버의 LAN 주소(외부 포트 17000 을 여기에만 연다)
OBSERVE_SECRET=                 # 조회용 서버 간 비밀값(X-Observe-Secret — 어드민과 같은 값). 비우면 조회를 전부 거절

# --- 로그 스트림: 같은 서버의 다른 compose 프로젝트(backend)의 Redis
REDIS_URL=                      # 예: redis://<LAN 주소>:6379
#OBSERVE_STREAM=logs            # 선택 — 기본 logs
#OBSERVE_GROUP=observe          # 선택 — 소비자 그룹 이름, 기본 observe

# --- 자원 지표: 각 서버의 ci-cd agent 가 위 REDIS_URL 의 Redis 로 보낸다(같은 Redis, 스트림만 다르다)
#METRICS_STREAM=metrics         # 선택 — 기본 metrics(agent 의 METRICS_STREAM 과 같은 값)
#METRICS_GROUP=observe          # 선택 — 소비자 그룹 이름, 기본 observe
METRICS_EXPECTED_SERVERS=       # 지표를 보내야 하는 서버 이름(agent 의 SERVER_NAME), 쉼표로. 예: ci-agent-9,ci-agent-158,ci-agent-164
#METRICS_ROLLUP_INTERVAL_MS=60000   # 선택 — 5분 평균 바퀴의 간격(밀리초), 기본 60000
#METRICS_JUDGE_INTERVAL_MS=30000    # 선택 — 임계값 판정 바퀴의 간격(밀리초), 기본 30000

# --- 방문: front 가 위 REDIS_URL 의 Redis 로 보낸다(같은 Redis, 스트림만 다르다). 방문자의 주소 원문은 DB 의 visit_event 표에만 90일 보관
#VISITS_STREAM=visits          # 선택 — 기본 visits(front 의 같은 이름 설정과 같은 값)
#VISITS_GROUP=observe          # 선택 — 소비자 그룹 이름, 기본 observe
#VISITS_RETENTION_CRON=0 40 3 * * *   # 선택 — 90일 삭제의 예약(서울 시각). '-'(끔)은 받지 않는다 — 주소를 저장하므로 삭제를 끌 수 없다(서버가 뜨지 않는다)
#VISITS_RETENTION_BATCH_SIZE=5000     # 선택 — 90일 삭제의 한 문장이 지우는 줄 수의 상한(1 이상), 기본 5000
#VISITS_RETENTION_TIME_BUDGET=5m      # 선택 — 90일 삭제 한 번의 시간 예산(0 보다 길게), 넘기면 멈추고 다음 날이 잇는다, 기본 5m

# --- 임계값 알림: 알림 서버 POST /events (ci-cd 와 같은 이름). 주소가 비면 보내지 않고 못 보낸 알림으로 남는다
ALERT_EVENTS_URL=               # 예: http://<알림 서버 LAN 주소>:<포트>/events
ALERT_SECRET=                   # 비밀값 — 알림 서버의 X-Alert-Secret 과 같은 값. 이 파일에는 적지 않는다
#ALERT_TIMEOUT_MS=3000          # 선택 — 알림 하나를 보내는 기한(밀리초)
#ALERT_DISPATCH_INTERVAL_MS=30000   # 선택 — 알림 보내기 바퀴의 간격(밀리초) — 판정과 따로 돈다
# 임계값(선택 — 비우면 명세 기본값. 목록은 README "임계값과 알림"). 예:
#METRICS_ALERT_DISK_WARNING_PCT=85
#METRICS_ALERT_MEMORY_PCT=90
#METRICS_ALERT_CPU_FOR=10m
#METRICS_ALERT_SILENT_WARM_UP=3m         # 끊김 판정을 시작하기까지(뜬 뒤 · 한 번 따라잡은 뒤)
#METRICS_ALERT_SILENT_GIVE_UP_AFTER=15m  # 따라잡지 못해도 이만큼 지나면 끊김을 판정

# --- 로그 무수신 알림(선택 — 둘 다 비면 판정이 꺼진다). 판정 주기는 METRICS_JUDGE_INTERVAL_MS, 알림은 위 ALERT_* 로 보낸다
LOG_ALERT_SERVICES=             # <서비스>@<사는 서버>=<기준(분)> 을 쉼표로, 기준 1~360분. 예: backend@ci-agent-158=30,front@ci-agent-9=45
LOG_ALERT_ALL_THRESHOLD_MINUTES=   # 전체 스트림 한 줄의 기준(분, 1~360). 예: 60
# 로그 글자 규칙: <이름>|<서비스>|<세기 info·warning·critical>|<글자> 를 ; 로(글자는 셋째 | 뒤의 전부 — 대소문자 구분 · 글자 그대로). 비면 꺼짐. 예(이 저장소의 쓰임):
LOG_ALERT_PATTERNS=claude_escalated|backend|info|claude run: result=answered auto=true;claude_limit|backend|warning|claude run: result=limit_reached;claude_unavailable|backend|warning|claude run: result=unavailable;claude_timeout|backend|warning|claude run: result=timeout
#LOG_ALERT_WARM_UP=3m           # 선택 — 뜬 뒤 판정을 시작하기까지. 그 뒤에도 로그 수집이 밀린 동안은 판정하지 않는다

# --- DB: postgres 컨테이너가 이 값으로 처음 만들어지고, 앱의 OBSERVE_DB_URL·USER·PASSWORD 도
#     docker-compose.yml 이 이 값으로 조립한다(OBSERVE_DB_* 는 따로 적지 않는다).
#     처음 뜬 뒤(data/postgres 가 생긴 뒤)에 바꾸면 DB 쪽은 바뀌지 않는다.
POSTGRES_DB=                    # 예: observe
POSTGRES_USER=                  # 예: observe
POSTGRES_PASSWORD=              # 영문·숫자만(예: openssl rand -hex 24) — `$` 가 들어가면 compose 가 변수로 읽는다

# --- 로그인 시도 잠금(선택 — 비우면 기본값: 연속 5회 실패 → 15분 잠금, 기록 90일 보관). 시간은 15m·90d 꼴
#OBSERVE_AUTH_FAILURE_LIMIT=<연속 실패 한도>
#OBSERVE_AUTH_LOCK_DURATION=<잠금 시간>
#OBSERVE_AUTH_RETENTION=<시도 기록 보관 기간>
